# Copy to .env and fill in. Only OPENROUTER_API_KEY is required.

# OpenRouter API key (https://openrouter.ai/)
OPENROUTER_API_KEY=

# Models (defaults shown; uncomment to override)
# IMOT_MODEL=google/gemma-4-31b-it:free
# IMOT_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# IMOT_VISION_MODEL=google/gemma-4-31b-it:free
# IMOT_VISION_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# Minimum score for a new listing to trigger a notification
# WATCH_MIN_SCORE=20

# ntfy.sh topic for phone notifications (topic is public, make it unguessable)
# NTFY_TOPIC=

# Where the SQLite databases live (defaults to the project root; Docker uses data/)
# IMOT_DATA_DIR=
